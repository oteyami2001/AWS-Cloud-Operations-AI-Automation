# After the first `apply`, copy to backend.tf, set the bucket from `terraform output state_bucket`,
# then run: terraform init -migrate-state
terraform {
  backend "s3" {
    bucket       = "aiops-tfstate-<account-id>-us-east-1"
    key          = "bootstrap/terraform.tfstate"
    region       = "us-east-1"
    encrypt      = true
    use_lockfile = true
  }
}
